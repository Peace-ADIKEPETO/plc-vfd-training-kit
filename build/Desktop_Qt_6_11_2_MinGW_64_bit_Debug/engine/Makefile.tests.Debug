clean: compiler_clean 
	-$(DEL_FILE) debug/ladder_engine.o debug/test_engine.o

distclean: clean 
	-$(DEL_FILE) $(DESTDIR_TARGET)
	-$(DEL_FILE) Makefile.tests.Debug

check: first

benchmark: first

compiler_no_pch_compiler_make_all:
compiler_no_pch_compiler_clean:
compiler_yacc_decl_make_all:
compiler_yacc_decl_clean:
compiler_yacc_impl_make_all:
compiler_yacc_impl_clean:
compiler_lex_make_all:
compiler_lex_clean:
compiler_clean: 



####### Compile

debug/ladder_engine.o: ../../../engine/ladder_engine.c ../../../engine/ladder_engine.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o debug/ladder_engine.o ../../../engine/ladder_engine.c

debug/test_engine.o: ../../../engine/test_engine.c ../../../engine/ladder_engine.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o debug/test_engine.o ../../../engine/test_engine.c

####### Install

install:  FORCE

uninstall:  FORCE

FORCE:

